# ─── Orders Service — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Django Core ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-change-in-production-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,orders-service

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Option A: Full DATABASE_URL (takes precedence)
DATABASE_URL=postgresql://orders_user:orders_pass@orders-db:5432/orders_db

# Option B: Individual vars (used if DATABASE_URL is not set)
DB_USER=orders_user
DB_PASSWORD=orders_pass
DB_HOST=orders-db
DB_PORT=5432
DB_NAME=orders_db

# ── Downstream Services ───────────────────────────────────────────────────────
CART_SERVICE_URL=http://cart-service:8002
CART_SERVICE_TIMEOUT=5

# ── Order Business Rules ──────────────────────────────────────────────────────
CANCELLABLE_STATUSES=PENDING,CONFIRMED

# ── Gunicorn ──────────────────────────────────────────────────────────────────
PORT=8003
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://ui-service:8080
CORS_ALLOW_ALL_ORIGINS=False
