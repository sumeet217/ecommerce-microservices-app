# ─── UI Service — Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Django core ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Backend service URLs ──────────────────────────────────────────────────────
# Internal Docker / k8s service names when running in compose/k8s.
# Change to http://localhost:<port> when running locally outside Docker.
CATALOG_SERVICE_URL=http://catalog-service:8001
CART_SERVICE_URL=http://cart-service:8002
ORDERS_SERVICE_URL=http://orders-service:8003

# Timeout (seconds) for outbound HTTP calls to backend services
SERVICE_TIMEOUT=8

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_PORT=8080
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30

# ── Pagination ────────────────────────────────────────────────────────────────
PRODUCTS_PER_PAGE=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
