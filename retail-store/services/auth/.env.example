# =============================================================================
# Auth Service Environment Variables — Example Template
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Auth Service — PostgreSQL Database
# -----------------------------------------------------------------------------
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=<secure-password>

# -----------------------------------------------------------------------------
# Auth Service — Django Configuration
# -----------------------------------------------------------------------------
AUTH_DJANGO_SECRET_KEY=<secret-key-min-50-chars>
AUTH_DJANGO_DEBUG=False
AUTH_DJANGO_ALLOWED_HOSTS=auth-service,localhost,127.0.0.1
AUTH_DJANGO_SETTINGS_MODULE=auth_service.settings

# Auth Service — Database connection
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=<secure-password>
AUTH_DATABASE_URL=

# Auth Service — JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=10080

# Auth Service — Gunicorn
AUTH_PORT=8000
AUTH_GUNICORN_WORKERS=3
AUTH_GUNICORN_TIMEOUT=30

# Auth Service — CORS
AUTH_CORS_ALLOWED_ORIGINS=http://localhost,http://ui-service,http://nginx
AUTH_CORS_ALLOW_ALL_ORIGINS=False

# Auth Service — Logging
AUTH_LOG_LEVEL=INFO
