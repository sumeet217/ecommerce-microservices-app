# ─── Cart Service — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Django Core ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-change-in-production-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cart-service

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Cart Behaviour ────────────────────────────────────────────────────────────
CART_TTL_SECONDS=604800        # 7 days
CART_MAX_ITEMS=50
CART_MAX_QUANTITY_PER_ITEM=99

# ── Downstream Services ───────────────────────────────────────────────────────
CATALOG_SERVICE_URL=http://catalog-service:8001
CATALOG_SERVICE_TIMEOUT=5

# ── Gunicorn ──────────────────────────────────────────────────────────────────
PORT=8002
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://ui-service:8080
CORS_ALLOW_ALL_ORIGINS=False
