# ─── Catalog Service — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Django Core ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-change-in-production-min-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,catalog-service

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: Full DATABASE_URL (takes precedence)
DATABASE_URL=postgresql://catalog_user:catalog_pass@catalog-db:5432/catalog_db

# Option B: Individual vars (used if DATABASE_URL is not set)
DB_USER=catalog_user
DB_PASSWORD=catalog_pass
DB_HOST=catalog-db
DB_PORT=5432
DB_NAME=catalog_db

# ── API ───────────────────────────────────────────────────────────────────────
PAGE_SIZE=20
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://ui-service:8080
CORS_ALLOW_ALL_ORIGINS=False
