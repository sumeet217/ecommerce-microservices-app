# =============================================================================
# RetailStore Environment Variables — Example Template
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL — Catalog Database
# Database credentials for the Catalog Service PostgreSQL instance
# -----------------------------------------------------------------------------
CATALOG_POSTGRES_DB=
CATALOG_POSTGRES_USER=
CATALOG_POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# PostgreSQL — Orders Database
# Database credentials for the Orders Service PostgreSQL instance
# -----------------------------------------------------------------------------
ORDERS_POSTGRES_DB=
ORDERS_POSTGRES_USER=
ORDERS_POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Redis Configuration
# Redis server settings for Cart Service
# -----------------------------------------------------------------------------
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_SAVE_INTERVAL=60 1
REDIS_LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Catalog Service — Django Configuration
# Django settings for the Catalog Service
# -----------------------------------------------------------------------------
CATALOG_DJANGO_SECRET_KEY=
CATALOG_DJANGO_DEBUG=False
CATALOG_DJANGO_ALLOWED_HOSTS=catalog-service,localhost,127.0.0.1
CATALOG_DJANGO_SETTINGS_MODULE=catalog_service.settings

# Catalog Service — Database
# PostgreSQL connection settings for Catalog Service
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=
CATALOG_DATABASE_URL=

# Catalog Service — Gunicorn
# Gunicorn WSGI server settings
CATALOG_PORT=8001
CATALOG_GUNICORN_WORKERS=3
CATALOG_GUNICORN_TIMEOUT=30

# Catalog Service — API Settings
# REST API configuration
CATALOG_PAGE_SIZE=20
CATALOG_CORS_ALLOWED_ORIGINS=http://localhost,http://ui-service,http://nginx
CATALOG_CORS_ALLOW_ALL_ORIGINS=False

# Catalog Service — Dev/Seed Settings
# Development helpers: superuser creation and demo data
CATALOG_CREATE_SUPERUSER=true
CATALOG_DJANGO_SUPERUSER_USERNAME=
CATALOG_DJANGO_SUPERUSER_EMAIL=
CATALOG_DJANGO_SUPERUSER_PASSWORD=
CATALOG_SEED_DEMO_DATA=true

# Catalog Service — Logging
CATALOG_LOG_LEVEL=INFO


# Cart Service — Django Configuration
# Django settings for the Cart Service

CART_DJANGO_SECRET_KEY=
CART_DJANGO_DEBUG=False
CART_DJANGO_ALLOWED_HOSTS=cart-service,localhost,127.0.0.1
CART_DJANGO_SETTINGS_MODULE=cart_service.settings

# Cart Service — Redis
# Redis connection URL for cart storage
CART_REDIS_URL=redis://redis:6379/0

# Cart Service — Business Rules
# Cart validation and limits
CART_TTL_SECONDS=604800
CART_MAX_ITEMS=50
CART_MAX_QUANTITY_PER_ITEM=99

# Cart Service — Downstream Services
# HTTP client settings for calling Catalog Service
CART_CATALOG_SERVICE_URL=http://catalog-service:8001
CART_CATALOG_SERVICE_TIMEOUT=5

# Cart Service — Gunicorn
CART_PORT=8002
CART_GUNICORN_WORKERS=3
CART_GUNICORN_TIMEOUT=30

# Cart Service — CORS
CART_CORS_ALLOWED_ORIGINS=http://localhost,http://ui-service,http://nginx
CART_CORS_ALLOW_ALL_ORIGINS=False

# Cart Service — Logging
CART_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Orders Service — Django Configuration
# Django settings for the Orders Service
# -----------------------------------------------------------------------------
ORDERS_DJANGO_SECRET_KEY=
ORDERS_DJANGO_DEBUG=False
ORDERS_DJANGO_ALLOWED_HOSTS=orders-service,localhost,127.0.0.1
ORDERS_DJANGO_SETTINGS_MODULE=orders_service.settings

# Orders Service — Database
# PostgreSQL connection settings for Orders Service
ORDERS_DB_HOST=orders-db
ORDERS_DB_PORT=5432
ORDERS_DB_NAME=
ORDERS_DB_USER=
ORDERS_DB_PASSWORD=
ORDERS_DATABASE_URL=

# Orders Service — Downstream Services
# HTTP client settings for calling Cart Service
ORDERS_CART_SERVICE_URL=http://cart-service:8002
ORDERS_CART_SERVICE_TIMEOUT=5

# Orders Service — Business Rules
# Order status machine configuration
ORDERS_CANCELLABLE_STATUSES=PENDING,CONFIRMED

# Orders Service — Gunicorn
ORDERS_PORT=8003
ORDERS_GUNICORN_WORKERS=3
ORDERS_GUNICORN_TIMEOUT=30

# Orders Service — CORS
ORDERS_CORS_ALLOWED_ORIGINS=http://localhost,http://ui-service,http://nginx
ORDERS_CORS_ALLOW_ALL_ORIGINS=False

# Orders Service — Logging
ORDERS_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# UI Service — Django Configuration
# Django settings for the UI Service (frontend)
# -----------------------------------------------------------------------------
UI_DJANGO_SECRET_KEY=
UI_DJANGO_DEBUG=False
UI_DJANGO_ALLOWED_HOSTS=ui-service,localhost,127.0.0.1,nginx
UI_DJANGO_SETTINGS_MODULE=ui_service.settings

# UI Service — Backend Service URLs
# HTTP client settings for calling backend services
UI_CATALOG_SERVICE_URL=http://catalog-service:8001
UI_CART_SERVICE_URL=http://cart-service:8002
UI_ORDERS_SERVICE_URL=http://orders-service:8003
UI_SERVICE_TIMEOUT=8

# UI Service — Pagination
UI_PRODUCTS_PER_PAGE=12

# UI Service — Gunicorn
UI_GUNICORN_PORT=8080
UI_GUNICORN_WORKERS=3
UI_GUNICORN_TIMEOUT=30

# UI Service — Logging
UI_LOG_LEVEL=INFO
